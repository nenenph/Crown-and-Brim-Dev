<section class="hero-section" style="position: relative; width: 100vw; margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); max-width: 100vw; height: 100vh; display: flex; align-items: flex-end; overflow: hidden; background-color: #0E0E0E; box-sizing: border-box;">
  <!-- 1. Background Video or Image Fallback -->
  {% if section.settings.video_file != blank %}
    {{ section.settings.video_file | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: "hero-bg-video" }}
  {% elsif section.settings.video_url != blank %}
    <video autoplay muted loop playsinline class="hero-bg-video">
      <source src="{{ section.settings.video_url }}" type="video/mp4">
      Your browser does not support the video tag.
    </video>
  {% elsif section.settings.fallback_image != blank %}
    <img src="{{ section.settings.fallback_image | image_url: width: 2000 }}" alt="Hero Background" class="hero-bg-video">
  {% endif %}

  <!-- 2. Middleground Color Overlay with Opacity Control -->
  <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; z-index: 2; pointer-events: none;"></div>

  <!-- Additional Subtle Bottom Gradient for Text Contrast -->
  <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(180deg, rgba(14,14,14,0) 40%, rgba(14,14,14,0.85) 100%); z-index: 3; pointer-events: none;"></div>

  <!-- 3. Foreground Editorial Content Container -->
  <div style="position: relative; z-index: 4; max-width: 1400px; width: 100%; margin: 0 auto; padding: 0 40px 80px 40px; box-sizing: border-box;" class="hero-content">
    <div style="max-width: 650px;">
      <h1 style="color: #F5F5F5; font-family: 'Oswald', sans-serif; font-size: clamp(3rem, 5.5vw, 6rem); font-weight: 700; line-height: 1.05; letter-spacing: 0.05em; text-transform: uppercase; margin: 0 0 20px 0;">
        {{ section.settings.heading | default: "THE VAULT IS OPEN" }}
      </h1>
      <p style="color: #CCCCCC; font-family: 'Inter', sans-serif; font-size: clamp(1rem, 1.5vw, 1.15rem); line-height: 1.5; font-weight: 400; margin: 0 0 35px 0; max-width: 500px;">
        {{ section.settings.subtext | default: "Permanent collection and limited-edition headwear engineered for precision and prestige." }}
      </p>

      <!-- Dual Action Buttons -->
      <div style="display: flex; gap: 16px; flex-wrap: wrap;">
        <a href="{{ section.settings.btn_primary_link | default: '/collections/all' }}" style="background: #D4AF37; color: #0E0E0E; padding: 16px 32px; text-decoration: none; font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; transition: background 0.2s;" onmouseover="this.style.backgroundColor='#E5C158'" onmouseout="this.style.backgroundColor='#D4AF37'">
          {{ section.settings.btn_primary_label | default: "Shop All Products" }}
        </a>
        <a href="{{ section.settings.btn_secondary_link | default: '/collections' }}" style="background: transparent; color: #F5F5F5; border: 1px solid rgba(245, 245, 245, 0.3); padding: 16px 32px; text-decoration: none; font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; transition: all 0.2s;" onmouseover="this.style.borderColor='#D4AF37'; this.style.color='#D4AF37';" onmouseout="this.style.borderColor='rgba(245, 245, 245, 0.3)'; this.style.color='#F5F5F5';">
          {{ section.settings.btn_secondary_label | default: "Explore Collections" }}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  html, body {
    overflow-x: hidden;
  }
  .hero-bg-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  @media (max-width: 768px) {
    .hero-content {
      padding: 0 24px 50px 24px !important;
    }
  }
</style>

{% schema %}
{
  "name": "Hero Video Banner",
  "settings": [
    {
      "type": "video",
      "id": "video_file",
      "label": "Background Video File"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Or Background Video URL (.mp4)"
    },
    {
      "type": "image_picker",
      "id": "fallback_image",
      "label": "Fallback Background Image"
    },
    {
      "type": "header",
      "content": "Middleground Overlay Settings"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Tint Color",
      "default": "#0E0E0E"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 45
    },
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE VAULT IS OPEN"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Permanent collection and limited-edition headwear engineered for precision and prestige."
    },
    {
      "type": "text",
      "id": "btn_primary_label",
      "label": "Primary Button Label",
      "default": "Shop All Products"
    },
    {
      "type": "url",
      "id": "btn_primary_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "btn_secondary_label",
      "label": "Secondary Button Label",
      "default": "Explore Collections"
    },
    {
      "type": "url",
      "id": "btn_secondary_link",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Video Banner"
    }
  ]
}
{% endschema %}