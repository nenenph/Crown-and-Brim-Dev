<!-- sections/main-collection-product-grid.liquid -->
<div class="collection-grid-architecture" style="background-color: {{ section.settings.bg_color }};">
  
  <!-- Brutalist Utility Bar (Filter & Sort) -->
  <div class="utility-bar">
    <button type="button" class="filter-trigger" onclick="openFilterDrawer()">
      [ FILTER + ]
    </button>

    <div class="active-filters-summary">
      {%- for filter in collection.filters -%}
        {%- for value in filter.active_values -%}
          <a href="{{ value.url_to_remove }}" class="active-filter-pill">
            {{ value.label }} ✕
          </a>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    <form class="sort-form" id="CollectionSortForm">
      <span class="sort-label">SORT BY:</span>
      <select name="sort_by" class="brutalist-select" onchange="this.form.submit();">
        {%- for option in collection.sort_options -%}
          <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected="selected"{% endif %}>
            {{ option.name | escape }}
          </option>
        {%- endfor -%}
      </select>
    </form>
  </div>

  <!-- Main Product Grid & Pagination Container -->
  <div class="grid-container">
    {% paginate collection.products by 24 %}
      <div class="blueprint-product-grid">
        {%- for product in collection.products -%}
          <div class="brutalist-card">
            <a href="{{ product.url }}" class="card-link">
              
              <!-- Image Swap Architecture with Inner Padding -->
              <div class="card-image-wrapper">
                <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title | escape }}" class="primary-image" loading="lazy">
                {% if product.images[1] %}
                  <img src="{{ product.images[1] | img_url: '600x' }}" alt="{{ product.title | escape }}" class="secondary-image" loading="lazy">
                {% endif %}
              </div>

              <!-- Card Meta -->
              <div class="card-meta">
                <h3 class="product-title" style="color: {{ section.settings.text_color }};">{{ product.title }}</h3>
                
                <div class="card-tags">
                  <span class="tag-badge">HEADWEAR</span>
                </div>

                <div class="price-architecture" style="color: {{ section.settings.accent_color }};">
                  {{ product.price | money }}
                </div>
              </div>

            </a>
          </div>
        {%- else -%}
          <div class="no-products">
            [ NO SILHOUETTES FOUND MATCHING THIS FILTER ]
          </div>
        {%- endfor -%}
      </div>

      <!-- Brutalist Pagination Controls -->
      {%- if paginate.pages > 1 -%}
        <div class="pagination-architecture">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="pagination-btn">[ PREV ]</a>
          {%- else -%}
            <span class="pagination-btn disabled">[ PREV ]</span>
          {%- endif -%}

          <div class="pagination-numbers">
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="page-number">{{ part.title }}</a>
              {%- else -%}
                {%- if part.title == paginate.current_page -%}
                  <span class="page-number active">{{ part.title }}</span>
                {%- else -%}
                  <span class="page-number ellipsis">{{ part.title }}</span>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="pagination-btn">[ NEXT ]</a>
          {%- else -%}
            <span class="pagination-btn disabled">[ NEXT ]</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    {% endpaginate %}
  </div>
</div>

<!-- Slide-Out Filter Drawer -->
<div id="FilterDrawer" class="filter-drawer" style="background-color: {{ section.settings.bg_color }};">
  <div class="drawer-header">
    <div>
      <h2 style="font-family: 'Oswald', sans-serif; color: {{ section.settings.text_color }}; margin: 0; font-size: 22px;">FILTER ARCHIVE</h2>
      <span style="font-family: monospace; font-size: 10px; color: #888888;">[ CROWN & BRIM SPECIFICATIONS ]</span>
    </div>
    <button type="button" class="close-drawer" onclick="closeFilterDrawer()" style="color: {{ section.settings.text_color }};">✕</button>
  </div>
  
  <form class="filter-form" id="CollectionFiltersForm" method="get">
    {%- if collection.sort_by != blank -%}
      <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
    {%- endif -%}

    <!-- Interactive Dual Price Range Slider Section -->
    <div class="filter-group">
      <h3 class="filter-title" style="color: {{ section.settings.accent_color }};">PRICE RANGE ($)</h3>
      
      <div class="price-slider-container">
        <div class="slider-track" id="SliderTrack"></div>
        <input type="range" id="RangeMin" min="0" max="200" value="0" class="range-input" oninput="syncRangeToInputs()">
        <input type="range" id="RangeMax" min="0" max="200" value="150" class="range-input" oninput="syncRangeToInputs()">
      </div>

      <div class="price-range-inputs">
        <div class="price-field">
          <span>$</span>
          <input type="number" id="InputPriceMin" name="filter.v.price.gte" value="0" placeholder="0" onchange="syncInputsToRange()">
        </div>
        <span style="color:#666; font-family: monospace;">TO</span>
        <div class="price-field">
          <span>$</span>
          <input type="number" id="InputPriceMax" name="filter.v.price.lte" value="150" placeholder="200" onchange="syncInputsToRange()">
        </div>
      </div>
    </div>

    <!-- Dynamic Shopify Native Filters (Accessory size, Metafield colors, Availability) -->
    {%- for filter in collection.filters -%}
      {%- if filter.type != 'price_range' -%}
        <div class="filter-group">
          <h3 class="filter-title" style="color: {{ section.settings.accent_color }};">{{ filter.label | upper }}</h3>
          
          {%- if filter.label == 'Accessory size' or filter.label == 'Size' -%}
            <!-- Size Pill Grid with hyphen-to-fraction label formatting -->
            <div class="size-pill-grid">
              {%- for value in filter.values -%}
                {% assign formatted_size = value.label | replace: '-1-8', ' 1/8' | replace: '-1-4', ' 1/4' | replace: '-3-8', ' 3/8' | replace: '-1-2', ' 1/2' | replace: '-5-8', ' 5/8' | replace: '-3-4', ' 3/4' %}
                <label class="size-pill">
                  <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"
                    {% if value.active %}checked{% endif %}
                    onchange="this.form.submit();"
                  >
                  <span>{{ formatted_size }}</span>
                </label>
              {%- endfor -%}
            </div>

          {%- elsif filter.label == 'Color' or filter.label == 'Cap Color' -%}
            <!-- Color Swatch List matching CSV colors -->
            <div class="color-swatch-grid">
              {%- for value in filter.values -%}
                {% assign color_handle = value.label | handleize %}
                <label class="swatch-btn">
                  <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"
                    {% if value.active %}checked{% endif %}
                    onchange="this.form.submit();"
                  >
                  <span class="swatch {{ color_handle }}"></span> {{ value.label | capitalize }} ({{ value.count }})
                </label>
              {%- endfor -%}
            </div>

          {%- else -%}
            <!-- Default Checklist for Availability and other options -->
            <ul class="filter-list">
              {%- for value in filter.values -%}
                <li>
                  <label class="filter-label" style="color: {{ section.settings.text_color }};">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"
                      {% if value.active %}checked{% endif %}
                      onchange="this.form.submit();"
                    >
                    <span class="checkbox-custom"></span>
                    {{ value.label }} <span class="count">({{ value.count }})</span>
                  </label>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}

    <div class="drawer-actions">
      <button type="submit" class="apply-btn">APPLY ARCHIVE FILTERS</button>
      <a href="{{ collection.url }}" class="clear-filters">RESET ALL</a>
    </div>
  </form>
</div>

<div id="DrawerOverlay" class="drawer-overlay" onclick="closeFilterDrawer()"></div>

<style>
  .collection-grid-architecture {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    max-width: 100vw;
    box-sizing: border-box;
    color: {{ section.settings.text_color }};
  }

  /* Utility Bar */
  .utility-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid {{ section.settings.grid_border }};
    padding: 16px 40px;
  }
  .filter-trigger {
    background: none;
    border: none;
    color: {{ section.settings.text_color }};
    font-family: monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    cursor: pointer;
  }
  .filter-trigger:hover {
    color: {{ section.settings.accent_color }};
  }
  .active-filters-summary {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .active-filter-pill {
    font-family: monospace;
    font-size: 10px;
    padding: 4px 8px;
    background: #1e1e1e;
    color: {{ section.settings.accent_color }};
    border: 1px solid {{ section.settings.accent_color }};
    text-decoration: none;
  }

  .sort-form {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .sort-label {
    font-family: monospace;
    font-size: 11px;
    color: #888888;
  }
  .brutalist-select {
    background: transparent;
    color: {{ section.settings.text_color }};
    border: 1px solid {{ section.settings.grid_border }};
    padding: 8px 12px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    text-transform: uppercase;
    cursor: pointer;
    outline: none;
  }

  /* Grid Layout Container & Cards */
  .grid-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px;
  }
  .blueprint-product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .brutalist-card {
    border: 1px solid {{ section.settings.grid_border }};
    background: {{ section.settings.card_bg }};
    transition: border-color 0.3s;
  }
  .brutalist-card:hover {
    border-color: {{ section.settings.accent_color }};
  }
  .card-link {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .card-image-wrapper {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #141414;
    padding: 24px;
  }
  .primary-image, .secondary-image {
    width: calc(100% - 48px);
    height: calc(100% - 48px);
    object-fit: contain;
    position: absolute;
    top: 24px;
    left: 24px;
    transition: opacity 0.4s ease;
  }
  .secondary-image {
    opacity: 0;
  }
  .card-link:hover .secondary-image {
    opacity: 1;
  }
  .card-link:hover .primary-image {
    opacity: 0;
  }
  
  .card-meta {
    padding: 20px;
    text-align: center;
    border-top: 1px solid {{ section.settings.grid_border }};
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
  }
  .product-title {
    font-family: 'Oswald', sans-serif;
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0;
    letter-spacing: 0.03em;
  }
  .card-tags {
    display: flex;
    gap: 6px;
  }
  .tag-badge {
    font-family: monospace;
    font-size: 9px;
    color: #888888;
    background: #181818;
    padding: 2px 6px;
    border: 1px solid #222;
  }
  .price-architecture {
    font-family: monospace;
    font-size: 13px;
    font-weight: 700;
  }

  /* Pagination Bar Styling */
  .pagination-architecture {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid {{ section.settings.grid_border }};
    font-family: monospace;
    font-size: 12px;
  }
  .pagination-btn {
    color: {{ section.settings.text_color }};
    text-decoration: none;
    padding: 10px 20px;
    border: 1px solid {{ section.settings.grid_border }};
    transition: all 0.2s ease;
  }
  .pagination-btn:hover:not(.disabled) {
    border-color: {{ section.settings.accent_color }};
    color: {{ section.settings.accent_color }};
  }
  .pagination-btn.disabled {
    color: #444444;
    border-color: #222222;
    cursor: not-allowed;
  }
  .pagination-numbers {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .page-number {
    color: {{ section.settings.text_color }};
    text-decoration: none;
    padding: 8px 14px;
    border: 1px solid {{ section.settings.grid_border }};
  }
  .page-number.active {
    background: {{ section.settings.accent_color }};
    color: #0E0E0E;
    border-color: {{ section.settings.accent_color }};
    font-weight: 700;
  }
  .page-number.ellipsis {
    border: none;
    color: #666666;
  }

  /* Filter Drawer */
  .filter-drawer {
    position: fixed;
    top: 0;
    left: -420px;
    width: 100%;
    max-width: 420px;
    height: 100vh;
    z-index: 100000;
    border-right: 1px solid {{ section.settings.grid_border }};
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    overflow-y: auto;
    box-sizing: border-box;
  }
  .filter-drawer.open {
    transform: translateX(420px);
  }
  .drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(14,14,14,0.85);
    backdrop-filter: blur(6px);
    z-index: 99999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s;
  }
  .drawer-overlay.open {
    opacity: 1;
    pointer-events: all;
  }
  .drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 32px 24px 20px 24px;
    border-bottom: 1px solid {{ section.settings.grid_border }};
  }
  .close-drawer {
    background: none;
    border: 1px solid {{ section.settings.grid_border }};
    padding: 6px 12px;
    font-size: 16px;
    cursor: pointer;
  }
  .close-drawer:hover {
    border-color: {{ section.settings.accent_color }};
  }

  .filter-group {
    border-bottom: 1px solid {{ section.settings.grid_border }};
    padding: 20px 24px;
  }
  .filter-title {
    font-family: monospace;
    font-size: 11px;
    font-weight: 700;
    margin: 0 0 14px 0;
    letter-spacing: 0.1em;
  }

  /* Price Range Slider */
  .price-slider-container {
    position: relative;
    width: 100%;
    height: 24px;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
  }
  .slider-track {
    position: absolute;
    height: 4px;
    width: 100%;
    background: #222222;
    border-radius: 2px;
  }
  .range-input {
    position: absolute;
    width: 100%;
    background: none;
    pointer-events: none;
    -webkit-appearance: none;
    appearance: none;
    margin: 0;
  }
  .range-input::-webkit-slider-thumb {
    height: 18px;
    width: 18px;
    border-radius: 0;
    background: {{ section.settings.accent_color }};
    border: 2px solid #0E0E0E;
    cursor: pointer;
    pointer-events: auto;
    -webkit-appearance: none;
  }
  .range-input::-moz-range-thumb {
    height: 18px;
    width: 18px;
    border-radius: 0;
    background: {{ section.settings.accent_color }};
    border: 2px solid #0E0E0E;
    cursor: pointer;
    pointer-events: auto;
  }

  .price-range-inputs {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .price-field {
    display: flex;
    align-items: center;
    background: #141414;
    border: 1px solid {{ section.settings.grid_border }};
    padding: 6px 10px;
    font-family: monospace;
    font-size: 12px;
    width: 100%;
  }
  .price-field input {
    background: transparent;
    border: none;
    color: #fff;
    width: 100%;
    outline: none;
    font-family: monospace;
  }

  /* Swatches & Size Pills */
  .color-swatch-grid {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .swatch-btn {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
  }
  .swatch-btn input { display: none; }
  .swatch {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    display: inline-block;
    border: 1px solid #333;
  }
  .swatch.blue { background: #1E3A8A; }
  .swatch.navy { background: #0A192F; }
  .swatch.beige { background: #C2B280; }
  .swatch.black { background: #111111; }
  .swatch.green { background: #004B23; }
  .swatch.white { background: #FFFFFF; border-color: #888; }
  .swatch.yellow, .swatch.yellow-gold { background: #EAB308; }
  .swatch.maroon, .swatch.maroon-black { background: #800020; }
  .swatch.brown, .swatch.brown-beige { background: #5C4033; }

  .swatch-btn input:checked + .swatch {
    outline: 2px solid {{ section.settings.accent_color }};
    outline-offset: 2px;
  }

  .filter-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .filter-label {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
  }
  .checkbox-custom {
    width: 14px;
    height: 14px;
    border: 1px solid {{ section.settings.grid_border }};
    display: inline-block;
  }
  .filter-label input:checked + .checkbox-custom {
    background-color: {{ section.settings.accent_color }};
    border-color: {{ section.settings.accent_color }};
  }

  .size-pill-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }
  .size-pill input { display: none; }
  .size-pill span {
    display: block;
    text-align: center;
    padding: 8px 0;
    border: 1px solid {{ section.settings.grid_border }};
    font-family: monospace;
    font-size: 11px;
    cursor: pointer;
  }
  .size-pill input:checked + span {
    border-color: {{ section.settings.accent_color }};
    color: {{ section.settings.accent_color }};
    background: #181818;
  }

  .drawer-actions {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .apply-btn {
    background: {{ section.settings.accent_color }};
    color: #0E0E0E;
    border: none;
    padding: 14px;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    letter-spacing: 0.05em;
    cursor: pointer;
  }
  .clear-filters {
    text-align: center;
    font-family: monospace;
    font-size: 11px;
    color: #888;
    text-decoration: underline;
  }

  .no-products {
    grid-column: 1 / -1;
    padding: 80px 20px;
    text-align: center;
    color: #888888;
    font-family: monospace;
    font-size: 12px;
  }

  /* Responsive Adjustments */
  @media (max-width: 1024px) {
    .blueprint-product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }
  @media (max-width: 640px) {
    .grid-container {
      padding: 20px 12px;
    }
    .utility-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      padding: 16px 20px;
    }
    .filter-drawer {
      left: -100%;
      max-width: 100%;
    }
    .filter-drawer.open {
      transform: translateX(100%);
    }
  }
</style>

<script>
  function openFilterDrawer() {
    document.getElementById('FilterDrawer').classList.add('open');
    document.getElementById('DrawerOverlay').classList.add('open');
    updateSliderFill();
  }
  function closeFilterDrawer() {
    document.getElementById('FilterDrawer').classList.remove('open');
    document.getElementById('DrawerOverlay').classList.remove('open');
  }

  /* Dual Range Price Slider Controller */
  function syncRangeToInputs() {
    let minVal = parseInt(document.getElementById('RangeMin').value);
    let maxVal = parseInt(document.getElementById('RangeMax').value);

    if (minVal > maxVal - 5) {
      document.getElementById('RangeMin').value = maxVal - 5;
      minVal = maxVal - 5;
    }

    document.getElementById('InputPriceMin').value = minVal;
    document.getElementById('InputPriceMax').value = maxVal;
    updateSliderFill();
  }

  function syncInputsToRange() {
    let minVal = parseInt(document.getElementById('InputPriceMin').value) || 0;
    let maxVal = parseInt(document.getElementById('InputPriceMax').value) || 200;

    document.getElementById('RangeMin').value = minVal;
    document.getElementById('RangeMax').value = maxVal;
    updateSliderFill();
  }

  function updateSliderFill() {
    const rangeMin = document.getElementById('RangeMin');
    const rangeMax = document.getElementById('RangeMax');
    const track = document.getElementById('SliderTrack');
    
    if (!rangeMin || !rangeMax || !track) return;

    const minPercent = (rangeMin.value / rangeMin.max) * 100;
    const maxPercent = (rangeMax.value / rangeMax.max) * 100;

    track.style.background = `linear-gradient(to right, #222 ${minPercent}%, #D4AF37 ${minPercent}%, #D4AF37 ${maxPercent}%, #222 ${maxPercent}%)`;
  }

  document.addEventListener('DOMContentLoaded', updateSliderFill);
</script>

{% schema %}
{
  "name": "Product Grid",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#0E0E0E"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#0E0E0E"
    },
    {
      "type": "color",
      "id": "grid_border",
      "label": "Grid Border",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Gold Accent",
      "default": "#D4AF37"
    }
  ]
}
{% endschema %}