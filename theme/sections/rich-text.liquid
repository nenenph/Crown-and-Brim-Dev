<!-- Full-Bleed Section Outer Wrapper -->
<section style="background-color: {{ section.settings.section_bg }}; width: 100vw; margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); max-width: 100vw; padding: 100px 40px; box-sizing: border-box; position: relative; overflow: hidden; border-top: 1px solid {{ section.settings.section_border }}; border-bottom: 1px solid {{ section.settings.section_border }};">
  
  <!-- Content Grid Container -->
  <div style="max-width: 1400px; margin: 0 auto;">
    <div class="narrative-grid-{{ section.id }} {% if section.settings.layout_desktop == 'image_right' %}reverse-layout{% endif %}">
      
      <!-- Media Container (Image or Video) -->
      <div class="narrative-media-wrap-{{ section.id }}">
        {% if section.settings.video_file != blank %}
          {{ section.settings.video_file | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: "narrative-media" }}
        {% elsif section.settings.video_url != blank %}
          <video autoplay muted loop playsinline class="narrative-media">
            <source src="{{ section.settings.video_url }}" type="video/mp4">
          </video>
        {% elsif section.settings.image != blank %}
          <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.heading }}" class="narrative-media" loading="lazy">
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'narrative-media placeholder-svg' }}
        {% endif %}
      </div>

      <!-- Overlapping Text Card -->
      <div class="narrative-card-{{ section.id }}">
        
        <!-- Small Subtag / Badge -->
        {% if section.settings.subtag != blank %}
          <span style="color: {{ section.settings.accent_color }}; font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.2em; display: block; margin-bottom: 12px;">
            {{ section.settings.subtag }}
          </span>
        {% endif %}

        <!-- Main Headline -->
        <h2 style="color: {{ section.settings.text_color }}; font-family: 'Oswald', sans-serif; font-size: clamp(2rem, 3.5vw, 3rem); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; line-height: 1.1; margin: 0 0 20px 0;">
          {{ section.settings.heading | default: "Engineered for the Crown" }}
        </h2>

        <!-- Narrative Description -->
        <div style="color: {{ section.settings.subtext_color }}; font-family: 'Inter', sans-serif; font-size: 14px; line-height: 1.7; font-weight: 400; margin-bottom: 30px;">
          {{ section.settings.body_text }}
        </div>

        <!-- 3-Point Spec Grid / Micro-Highlights -->
        {% if section.settings.show_specs %}
          <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; padding-top: 24px; margin-top: 10px; border-top: 1px solid rgba(255, 255, 255, 0.08); margin-bottom: 35px;" class="specs-grid">
            <div>
              <span style="color: {{ section.settings.accent_color }}; font-family: 'Oswald', sans-serif; font-size: 11px; font-weight: 700; display: block; margin-bottom: 4px;">{{ section.settings.spec1_num }}</span>
              <p style="color: {{ section.settings.text_color }}; font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 600; text-transform: uppercase; margin: 0; letter-spacing: 0.05em;">{{ section.settings.spec1_text }}</p>
            </div>
            <div>
              <span style="color: {{ section.settings.accent_color }}; font-family: 'Oswald', sans-serif; font-size: 11px; font-weight: 700; display: block; margin-bottom: 4px;">{{ section.settings.spec2_num }}</span>
              <p style="color: {{ section.settings.text_color }}; font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 600; text-transform: uppercase; margin: 0; letter-spacing: 0.05em;">{{ section.settings.spec2_text }}</p>
            </div>
            <div>
              <span style="color: {{ section.settings.accent_color }}; font-family: 'Oswald', sans-serif; font-size: 11px; font-weight: 700; display: block; margin-bottom: 4px;">{{ section.settings.spec3_num }}</span>
              <p style="color: {{ section.settings.text_color }}; font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 600; text-transform: uppercase; margin: 0; letter-spacing: 0.05em;">{{ section.settings.spec3_text }}</p>
            </div>
          </div>
        {% endif %}

        <!-- CTA Button -->
        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link | default: '/pages/about' }}" style="display: inline-block; background-color: {{ section.settings.btn_bg }}; color: {{ section.settings.btn_text }}; padding: 16px 36px; text-decoration: none; font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; transition: all 0.2s;" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
            {{ section.settings.button_label }}
          </a>
        {% endif %}

      </div>

    </div>
  </div>
</section>

<!-- Layout Styles & Overlap Calculations -->
<style>
  html, body {
    overflow-x: hidden;
  }

  .narrative-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    align-items: center;
    position: relative;
  }

  /* Default Image Left / Card Right Overlap */
  .narrative-media-wrap-{{ section.id }} {
    grid-column: 1 / 8;
    grid-row: 1;
    position: relative;
    width: 100%;
    height: 580px;
    border: 1px solid {{ section.settings.card_border }};
    overflow: hidden;
  }

  .narrative-card-{{ section.id }} {
    grid-column: 6 / 13;
    grid-row: 1;
    z-index: 2;
    background-color: {{ section.settings.card_bg }};
    border: 1px solid {{ section.settings.card_border }};
    padding: 56px 48px;
    box-sizing: border-box;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(8px);
  }

  /* Reversed Layout: Image Right / Card Left Overlap */
  .narrative-grid-{{ section.id }}.reverse-layout .narrative-media-wrap-{{ section.id }} {
    grid-column: 6 / 13;
  }

  .narrative-grid-{{ section.id }}.reverse-layout .narrative-card-{{ section.id }} {
    grid-column: 1 / 8;
  }

  .narrative-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .placeholder-svg {
    filter: invert(0.9);
    background: #141414;
  }

  /* Mobile Responsive Stacking */
  @media (max-width: 900px) {
    .narrative-grid-{{ section.id }},
    .narrative-grid-{{ section.id }}.reverse-layout {
      display: flex;
      flex-direction: column;
    }

    .narrative-media-wrap-{{ section.id }} {
      width: 100%;
      height: 380px;
      margin-bottom: -40px;
      z-index: 1;
    }

    .narrative-card-{{ section.id }} {
      width: 92%;
      margin: 0 auto;
      padding: 36px 24px;
      z-index: 2;
    }

    .specs-grid {
      grid-template-columns: 1fr !important;
      gap: 12px !important;
    }
  }
</style>

