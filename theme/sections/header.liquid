<!-- sections/header.liquid -->
<header id="CrownHeader" style="background: transparent; border-bottom: none; padding: 22px 40px; position: fixed; top: 0; left: 0; width: 100%; z-index: 9999; box-sizing: border-box; transition: all 0.3s ease;">
  <div style="display: flex; justify-content: space-between; align-items: center; max-width: 1400px; margin: 0 auto; position: relative; width: 100%;">
    
    <!-- Left: Mobile Menu Trigger & Minimal Desktop Nav -->
    <div style="display: flex; align-items: center; gap: 20px; z-index: 2;">
      <!-- Mobile Hamburger Button -->
      <button id="MobileMenuBtn" aria-label="Open Menu" style="background: none; border: none; color: #F5F5F5; cursor: pointer; display: none; padding: 0;" class="mobile-only-flex">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/></svg>
      </button>

      <!-- Desktop Minimal Nav -->
      <nav style="display: flex; gap: 28px;" class="desktop-only-flex">
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}" style="color: #CCCCCC; text-decoration: none; font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.12em; transition: color 0.2s;" onmouseover="this.style.color='#D4AF37'" onmouseout="this.style.color='#CCCCCC'">
            {{ link.title }}
          </a>
        {% endfor %}
        {% if section.settings.menu == blank %}
          <a href="/" style="color: #CCCCCC; text-decoration: none; font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.12em;">Shop</a>
          <a href="/collections/all" style="color: #CCCCCC; text-decoration: none; font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.12em;">Vault</a>
        {% endif %}
      </nav>
    </div>

    <!-- Center: Brand Logo (Strictly locked to absolute center) -->
    <div style="text-align: center; position: absolute; left: 50%; transform: translateX(-50%); z-index: 1;">
      <a href="{{ routes.root_url }}" style="text-decoration: none; display: flex; align-items: center; justify-content: center;">
        {% if section.settings.logo_image != blank %}
          <img src="{{ section.settings.logo_image | image_url: width: 200 }}" alt="{{ shop.name }}" style="max-height: {{ section.settings.logo_height }}px; width: auto; display: block;">
        {% else %}
          <span style="color: #F5F5F5; font-family: 'Oswald', sans-serif; font-size: 22px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; white-space: nowrap;">
            {{ shop.name | default: "CROWN & BRIM CO." }}
          </span>
        {% endif %}
      </a>
    </div>

    <!-- Right: Utility Icons -->
    <div style="display: flex; align-items: center; gap: 20px; z-index: 2;">
      <a href="{{ routes.search_url }}" id="SearchModalTrigger" style="color: #F5F5F5; text-decoration: none; display: flex; align-items: center;" title="Search">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
      </a>
      <a href="{{ routes.cart_url }}" id="HeaderCartLink" style="color: #F5F5F5; text-decoration: none; display: flex; align-items: center; gap: 6px;" title="Cart">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg>
        <span id="HeaderCartBadge" style="font-family: 'Inter', sans-serif; font-size: 11px; background: #D4AF37; color: #0E0E0E; padding: 1px 5px; font-weight: 700; border-radius: 2px;">{{ cart.item_count }}</span>
      </a>
    </div>

  </div>

  <!-- Mobile Slide-out Drawer -->
  <div id="MobileDrawer" style="position: fixed; top: 0; left: -100%; width: 80%; max-width: 320px; height: 100vh; background: #0E0E0E; z-index: 10000; transition: left 0.3s ease; padding: 40px 24px; box-sizing: border-box; border-right: 1px solid #222;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px;">
      <span style="color: #D4AF37; font-family: 'Oswald', sans-serif; font-size: 16px; letter-spacing: 0.1em; text-transform: uppercase;">Menu</span>
      <button id="CloseDrawerBtn" style="background: none; border: none; color: #F5F5F5; cursor: pointer; padding: 0;">
        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <nav style="display: flex; flex-direction: column; gap: 24px;">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}" style="color: #F5F5F5; text-decoration: none; font-family: 'Inter', sans-serif; font-size: 16px; text-transform: uppercase; letter-spacing: 0.05em;">
          {{ link.title }}
        </a>
      {% endfor %}
      {% if section.settings.menu == blank %}
        <a href="/" style="color: #F5F5F5; text-decoration: none; font-family: 'Inter', sans-serif; font-size: 16px; text-transform: uppercase;">Shop</a>
        <a href="/collections/all" style="color: #F5F5F5; text-decoration: none; font-family: 'Inter', sans-serif; font-size: 16px; text-transform: uppercase;">Vault</a>
      {% endif %}
    </nav>
  </div>
  <div id="DrawerOverlay" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.6); z-index: 9999; display: none; opacity: 0; transition: opacity 0.3s ease;"></div>

  <!-- Terminal Search Modal Overlay -->
  <div id="TerminalSearchModal" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(14, 14, 14, 0.92); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); z-index: 10005; display: none; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.25s ease;">
    <div style="width: 100%; max-width: 600px; padding: 0 24px; box-sizing: border-box;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <span style="font-family: monospace; font-size: 11px; color: #D4AF37; letter-spacing: 0.15em;">[ SYSTEM QUERY // VAULT SEARCH ]</span>
        <button type="button" id="CloseSearchModal" style="background: none; border: none; color: #888; font-family: monospace; font-size: 12px; cursor: pointer; letter-spacing: 0.1em;" onmouseover="this.style.color='#F5F5F5'" onmouseout="this.style.color='#888'">[ CLOSE X ]</button>
      </div>
      
      <form action="{{ routes.search_url }}" method="get" role="search" style="display: flex; border: 1px solid #333; background: #141414;">
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="ENTER ARTIFACT OR CROWN QUERY..." style="flex-grow: 1; background: transparent; border: none; color: #F5F5F5; font-family: monospace; font-size: 14px; padding: 18px 20px; outline: none;" id="TerminalSearchInput" autocomplete="off">
        <button type="submit" style="background: #D4AF37; border: none; color: #0E0E0E; font-family: 'Oswald', sans-serif; font-size: 13px; font-weight: 700; padding: 0 24px; cursor: pointer; letter-spacing: 0.05em; transition: opacity 0.2s;" onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">
          SEARCH
        </button>
      </form>
      <div style="margin-top: 12px; font-family: monospace; font-size: 10px; color: #666; letter-spacing: 0.05em;">
        PRESS ESC TO ABORT OR HIT ENTER TO EXECUTE QUERY.
      </div>
    </div>
  </div>
</header>

<style>
  /* Collapse menu into hamburger drawer at 1260px to prevent text crowding */
  @media (max-width: 1260px) {
    .desktop-only-flex { display: none !important; }
    .mobile-only-flex { display: flex !important; }
  }
</style>

<script>
  window.addEventListener('scroll', function() {
    const header = document.getElementById('CrownHeader');
    if (window.scrollY > 20) {
      header.style.background = 'rgba(14, 14, 14, 0.85)';
      header.style.backdropFilter = 'blur(12px)';
      header.style.webkitBackdropFilter = 'blur(12px)';
      header.style.borderBottom = '1px solid rgba(212, 175, 55, 0.2)';
    } else {
      header.style.background = 'transparent';
      header.style.backdropFilter = 'none';
      header.style.webkitBackdropFilter = 'none';
      header.style.borderBottom = 'none';
    }
  });

  const menuBtn = document.getElementById('MobileMenuBtn');
  const closeBtn = document.getElementById('CloseDrawerBtn');
  const drawer = document.getElementById('MobileDrawer');
  const overlay = document.getElementById('DrawerOverlay');

  function openMenu() {
    drawer.style.left = '0';
    overlay.style.display = 'block';
    setTimeout(() => { overlay.style.opacity = '1'; }, 10);
  }

  function closeMenu() {
    drawer.style.left = '-100%';
    overlay.style.opacity = '0';
    setTimeout(() => { overlay.style.display = 'none'; }, 300);
  }

  if (menuBtn) menuBtn.addEventListener('click', openMenu);
  if (closeBtn) closeBtn.addEventListener('click', closeMenu);
  if (overlay) overlay.addEventListener('click', closeMenu);

  // Search Modal Interception Logic
  const searchTrigger = document.getElementById('SearchModalTrigger');
  const searchModal = document.getElementById('TerminalSearchModal');
  const closeSearchBtn = document.getElementById('CloseSearchModal');
  const searchInput = document.getElementById('TerminalSearchInput');

  function openSearchModal(e) {
    if (e) e.preventDefault();
    searchModal.style.display = 'flex';
    setTimeout(() => {
      searchModal.style.opacity = '1';
      if (searchInput) searchInput.focus();
    }, 10);
  }

  function closeSearchModal() {
    searchModal.style.opacity = '0';
    setTimeout(() => {
      searchModal.style.display = 'none';
    }, 250);
  }

  if (searchTrigger) searchTrigger.addEventListener('click', openSearchModal);
  if (closeSearchBtn) closeSearchBtn.addEventListener('click', closeSearchModal);

  // Close on ESC key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeSearchModal();
      closeMenu();
    }
  });

  // Close when clicking outside the search box
  if (searchModal) {
    searchModal.addEventListener('click', function(e) {
      if (e.target === searchModal) {
        closeSearchModal();
      }
    });
  }
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Custom Logo Image"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Logo Height",
      "default": 32
    }
  ]
}
{% endschema %}