<!-- sections/crown-matrix-calculator.liquid -->
<div id="crown-matrix" class="cm-terminal-container" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; border-top: 1px solid {{ section.settings.grid_border }}; border-bottom: 1px solid {{ section.settings.grid_border }};">
  <div class="cm-inner">
    
    <!-- Header -->
    <div class="cm-header" style="border-color: {{ section.settings.grid_border }};">
      <span class="cm-tag" style="color: {{ section.settings.accent_color }};">
        [ DIAGNOSTIC TOOL // DAY 3 MILESTONE ]
      </span>
      <h2 class="cm-title">
        CROWN <span style="color: {{ section.settings.accent_color }};">MATRIX</span> CALCULATOR
      </h2>
      <p class="cm-subtitle">
        INPUT CRANIUM PARAMETERS TO EXECUTE ARCHITECTURAL SIZING MATCH.
      </p>
    </div>

    <!-- Interactive Grid Layout -->
    <div class="cm-grid">
      
      <!-- Input Panel -->
      <div class="cm-input-panel" style="border-color: {{ section.settings.grid_border }}; background: {{ section.settings.card_bg }};">
        <div class="cm-panel-header" style="border-color: {{ section.settings.grid_border }}; color: {{ section.settings.accent_color }};">
          [ 01. PARAMETER ENTRY ]
        </div>
        
        <div class="cm-form-group">
          <label for="CmMeasurementInput" class="cm-label">HEAD CIRCUMFERENCE:</label>
          <div class="cm-input-row">
            <input type="number" id="CmMeasurementInput" placeholder="e.g. 58" min="50" max="65" step="0.5" class="cm-text-input" style="color: {{ section.settings.text_color }}; border-color: {{ section.settings.grid_border }};">
            <select id="CmUnitSelect" class="cm-select" style="color: {{ section.settings.text_color }}; border-color: {{ section.settings.grid_border }}; background: {{ section.settings.bg_color }};">
              <option value="cm">CM</option>
              <option value="in">INCHES</option>
            </select>
          </div>
        </div>

        <div class="cm-form-group">
          <label class="cm-label">FIT ARCHITECTURE PREFERENCE:</label>
          <div class="cm-radio-group">
            <label class="cm-radio-label" style="border-color: {{ section.settings.grid_border }};">
              <input type="radio" name="CmFitPreference" value="snug" class="cm-radio"> SNUG [TIGHTER CLEARANCE]
            </label>
            <label class="cm-radio-label active" style="border-color: {{ section.settings.grid_border }};">
              <input type="radio" name="CmFitPreference" value="standard" checked class="cm-radio"> STANDARD [BALANCED]
            </label>
            <label class="cm-radio-label" style="border-color: {{ section.settings.grid_border }};">
              <input type="radio" name="CmFitPreference" value="relaxed" class="cm-radio"> RELAXED [LOOSE]
            </label>
          </div>
        </div>

        <button type="button" id="CmCalculateBtn" class="cm-calc-btn" style="background: {{ section.settings.accent_color }}; color: {{ section.settings.bg_color }};">
          [ RUN CROWN DIAGNOSTIC ]
        </button>
      </div>

      <!-- Terminal Output Display Panel -->
      <div class="cm-output-panel" style="border-color: {{ section.settings.grid_border }}; background: #0A0A0A;">
        <div class="cm-panel-header" style="border-color: {{ section.settings.grid_border }}; color: {{ section.settings.accent_color }};">
          [ 02. DIAGNOSTIC TELEMETRY ]
        </div>
        
        <div id="CmTerminalScreen" class="cm-terminal-screen">
          <p class="cm-log-line" style="color: #666;">[SYSTEM READY. AWAITING INPUT PARAMETERS...]</p>
        </div>

        <div id="CmResultBox" class="cm-result-box" style="border-top: 1px solid {{ section.settings.grid_border }}; display: none;">
          <div class="cm-result-item">
            <span class="cm-result-key">OPTIMAL TIER:</span>
            <span id="CmResultSize" class="cm-result-val" style="color: {{ section.settings.accent_color }};">--</span>
          </div>
          <div class="cm-result-item">
            <span class="cm-result-key">TOLERANCE CLEARANCE:</span>
            <span id="CmResultTolerance" class="cm-result-val">--</span>
          </div>
          <a href="/collections/all" id="CmShopLink" class="cm-action-link" style="border-color: {{ section.settings.accent_color }}; color: {{ section.settings.accent_color }};">
            [ FILTER VAULT FOR THIS TIER &rarr; ]
          </a>
        </div>
      </div>

    </div>

  </div>
</div>

<style>
  .cm-terminal-container {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    max-width: 100vw;
    box-sizing: border-box;
    padding: 100px 40px;
  }
  .cm-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 50px;
  }
  .cm-header {
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-bottom: 1px solid;
    padding-bottom: 24px;
  }
  .cm-tag {
    font-family: monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
  }
  .cm-title {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 700;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.1;
  }
  .cm-subtitle {
    font-family: monospace;
    font-size: 13px;
    color: #888888;
    margin: 0;
    letter-spacing: 0.05em;
  }
  .cm-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .cm-input-panel, .cm-output-panel {
    border: 1px solid;
    display: flex;
    flex-direction: column;
  }
  .cm-panel-header {
    font-family: monospace;
    font-size: 12px;
    font-weight: 700;
    padding: 16px 24px;
    border-bottom: 1px solid;
    letter-spacing: 0.1em;
    background: #121212;
  }
  .cm-form-group {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-bottom: 1px solid #1c1c1c;
  }
  .cm-label {
    font-family: monospace;
    font-size: 11px;
    color: #888;
    letter-spacing: 0.1em;
  }
  .cm-input-row {
    display: flex;
    gap: 12px;
  }
  .cm-text-input {
    flex: 1;
    background: #141414;
    border: 1px solid;
    padding: 14px 16px;
    font-family: monospace;
    font-size: 16px;
    outline: none;
  }
  .cm-select {
    background: #141414;
    border: 1px solid;
    padding: 14px 16px;
    font-family: monospace;
    font-size: 14px;
    outline: none;
    cursor: pointer;
  }
  .cm-radio-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cm-radio-label {
    font-family: monospace;
    font-size: 12px;
    padding: 12px 16px;
    border: 1px solid;
    background: #141414;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 10px;
    transition: border-color 0.2s;
  }
  .cm-radio-label:hover {
    border-color: {{ section.settings.accent_color }};
  }
  .cm-radio {
    accent-color: {{ section.settings.accent_color }};
  }
  .cm-calc-btn {
    border: none;
    font-family: 'Oswald', sans-serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 20px;
    cursor: pointer;
    text-align: center;
    transition: opacity 0.2s;
    margin: 24px;
  }
  .cm-calc-btn:hover {
    opacity: 0.9;
  }
  .cm-terminal-screen {
    padding: 24px;
    font-family: monospace;
    font-size: 13px;
    min-height: 180px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    overflow-y: auto;
  }
  .cm-log-line {
    margin: 0;
    letter-spacing: 0.05em;
    line-height: 1.4;
  }
  .cm-result-box {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: #121212;
  }
  .cm-result-item {
    display: flex;
    justify-content: space-between;
    font-family: monospace;
    font-size: 13px;
  }
  .cm-result-key {
    color: #888;
  }
  .cm-result-val {
    font-weight: 700;
  }
  .cm-action-link {
    font-family: monospace;
    font-size: 12px;
    text-decoration: none;
    border: 1px dashed;
    padding: 12px;
    text-align: center;
    letter-spacing: 0.1em;
    transition: background 0.2s;
  }
  .cm-action-link:hover {
    background: rgba(212, 175, 55, 0.1);
  }

  @media (max-width: 1024px) {
    .cm-grid {
      grid-template-columns: 1fr;
    }
    .cm-terminal-container {
      padding: 60px 20px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const calcBtn = document.getElementById('CmCalculateBtn');
    if (!calcBtn) return;

    calcBtn.addEventListener('click', () => {
      const inputVal = parseFloat(document.getElementById('CmMeasurementInput').value);
      const unit = document.getElementById('CmUnitSelect').value;
      const fitPref = document.querySelector('input[name="CmFitPreference"]:checked').value;
      const terminalScreen = document.getElementById('CmTerminalScreen');
      const resultBox = document.getElementById('CmResultBox');
      
      if (isNaN(inputVal) || inputVal <= 0) {
        alert('PLEASE ENTER A VALID CRANIUM MEASUREMENT.');
        return;
      }

      // Convert inches to cm for calculation if needed
      let cmVal = unit === 'in' ? inputVal * 2.54 : inputVal;

      // Reset and run simulated diagnostic logs
      terminalScreen.innerHTML = '';
      resultBox.style.display = 'none';

      const logs = [
        `> INITIALIZING CROWN MATRIX PROTOCOL v3.0...`,
        `> PARSING PARAMETERS: ${inputVal}${unit} [${fitPref.toUpperCase()} FIT]`,
        `> CALCULATING CRANIAL TOLERANCE INDICES...`,
        `> CORRELATING WITH VAULT ARTIFACT DATABASE...`
      ];

      let delay = 0;
      logs.forEach((log, index) => {
        setTimeout(() => {
          const p = document.createElement('p');
          p.className = 'cm-log-line';
          p.style.color = index === logs.length - 1 ? '{{ section.settings.accent_color }}' : '#aaa';
          p.textContent = log;
          terminalScreen.appendChild(p);
          terminalScreen.scrollTop = terminalScreen.scrollHeight;
        }, delay);
        delay += 350;
      });

      // Compute Size Tier after terminal simulation
      setTimeout(() => {
        let sizeTier = 'MEDIUM (M)';
        let tolerance = '± 0.5cm (Standard Fit)';

        if (cmVal < 55) {
          sizeTier = 'SMALL (S)';
          tolerance = '± 0.3cm (Compact Fit)';
        } else if (cmVal >= 55 && cmVal < 57.5) {
          sizeTier = 'MEDIUM (M)';
          tolerance = '± 0.5cm (Standard Fit)';
        } else if (cmVal >= 57.5 && cmVal < 60) {
          sizeTier = 'LARGE (L)';
          tolerance = '± 0.5cm (Extended Fit)';
        } else {
          sizeTier = 'EXTRA LARGE (XL)';
          tolerance = '± 0.8cm (Maximum Clearance)';
        }

        document.getElementById('CmResultSize').textContent = sizeTier;
        document.getElementById('CmResultTolerance').textContent = tolerance;
        resultBox.style.display = 'flex';
      }, delay + 100);
    });
  });
  // Smooth scroll handler for the Launch Crown Matrix button
  document.addEventListener('click', (e) => {
    const trigger = e.target.closest('a[href="#crown-matrix"], [data-launch-matrix]');
    if (!trigger) return;

    e.preventDefault();
    const targetSection = document.getElementById('crown-matrix');
    
    if (targetSection) {
      const header = document.getElementById('CrownHeader');
      const headerHeight = header ? header.offsetHeight : 80;
      const targetPosition = targetSection.getBoundingClientRect().top + window.pageYOffset - headerHeight - 20;

      window.scrollTo({
        top: targetPosition,
        behavior: 'smooth'
      });
    }
  });
</script>

{% schema %}
{
  "name": "Crown Matrix Calculator",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#0E0E0E"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#0E0E0E"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Gold Accent",
      "default": "#D4AF37"
    },
    {
      "type": "color",
      "id": "grid_border",
      "label": "Grid Border",
      "default": "#222222"
    }
  ],
  "presets": [
    {
      "name": "Crown Matrix Calculator"
    }
  ]
}
{% endschema %}