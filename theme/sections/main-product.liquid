<!-- sections/main-product.liquid -->
<div class="pdp-architecture" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="pdp-container">
    
    <!-- Left Column: Viewport-Fitted Sticky Gallery with Top-Left Icon Back Button -->
    <div class="pdp-gallery-column">
      <div class="sticky-gallery-wrapper">
        <div class="gallery-top-bar">
          <a href="{{ collection.url | default: routes.all_products_collection_url }}" class="back-icon-btn" aria-label="Return to Archive">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
          </a>
        </div>

        <div class="main-image-viewport">
          {%- if product.selected_or_first_available_variant.featured_image != blank -%}
            {%- assign featured_image = product.selected_or_first_available_variant.featured_image -%}
          {%- else -%}
            {%- assign featured_image = product.featured_image -%}
          {%- endif -%}
          
          <img src="{{ featured_image | img_url: '1200x' }}" alt="{{ product.title | escape }}" id="MainProductImage" class="main-viewport-img" loading="eager">
        </div>

        {%- if product.images.size > 1 -%}
          <div class="thumbnail-track">
            {%- for image in product.images -%}
              <button type="button" class="thumb-btn {% if image == featured_image %}active{% endif %}" onclick="switchProductImage('{{ image | img_url: '1200x' }}', this)">
                <img src="{{ image | img_url: '200x' }}" alt="{{ product.title | escape }}" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    <!-- Right Column: Product Info, Technical Size Matrix & Cart Form -->
    <div class="pdp-info-column">
      <div class="sticky-info-wrapper">
        <div class="product-header-meta">
          <span class="blueprint-tag" style="color: {{ section.settings.accent_color }};">
            [ ARCHIVE REF // {{ product.vendor | default: 'CROWN & BRIM' }} ]
          </span>
          <h1 class="pdp-title">{{ product.title }}</h1>
          <div class="pdp-price" id="ProductPrice" style="color: {{ section.settings.accent_color }};">
            {{ product.selected_or_first_available_variant.price | money }}
          </div>
        </div>

        <div class="pdp-description">
          {{ product.description }}
        </div>

        {%- form 'product', product, id: "ProductForm", class: "pdp-form" -%}
          <input type="hidden" name="id" id="VariantIdInput" value="{{ product.selected_or_first_available_variant.id }}">

          <!-- Technical Size Matrix -->
          <div class="variant-picker-group">
            <div class="picker-header">
              <span class="picker-label">SELECT FIT SIZE:</span>
              <span class="selected-size-display" id="SelectedSizeDisplay">
                {{ product.selected_or_first_available_variant.option1 | replace: '-1-8', ' 1/8' | replace: '-1-4', ' 1/4' | replace: '-3-8', ' 3/8' | replace: '-1-2', ' 1/2' | replace: '-5-8', ' 5/8' | replace: '-3-4', ' 3/4' }}
              </span>
            </div>

            <div class="size-matrix-grid">
              {%- for variant in product.variants -%}
                {% assign clean_size = variant.option1 | replace: '-1-8', ' 1/8' | replace: '-1-4', ' 1/4' | replace: '-3-8', ' 3/8' | replace: '-1-2', ' 1/2' | replace: '-5-8', ' 5/8' | replace: '-3-4', ' 3/4' %}
                <button type="button" 
                  class="size-matrix-btn {% if variant == product.selected_or_first_available_variant %}active{% endif %} {% unless variant.available %}sold-out{% endunless %}"
                  data-variant-id="{{ variant.id }}"
                  data-variant-price="{{ variant.price | money }}"
                  data-variant-available="{{ variant.available }}"
                  data-size-label="{{ clean_size }}"
                  onclick="selectVariant(this)"
                  {% unless variant.available %}disabled{% endunless %}
                >
                  {{ clean_size }}
                </button>
              {%- endfor -%}
            </div>
          </div>

          <!-- Action Buttons with Detached Top Margin & Cart UX -->
          <div class="pdp-action-bar">
            <button type="submit" name="add" id="AddToCartBtn" class="add-to-cart-btn">
              {% if product.selected_or_first_available_variant.available %}
                [ ADD TO CART ]
              {% else %}
                [ SOLD OUT ]
              {% endif %}
            </button>
            
            <button type="button" class="crown-matrix-trigger-btn" onclick="openCrownMatrixModal()">
              [ LAUNCH CROWN MATRIX ]
            </button>
          </div>
        {%- endform -%}

        <!-- Brutalist Accordions -->
        <div class="pdp-accordions">
          <div class="accordion-item">
            <button type="button" class="accordion-toggle" onclick="toggleAccordion(this)">
              <span>SILHOUETTE & SPECIFICATIONS</span>
              <span class="acc-icon">[ + ]</span>
            </button>
            <div class="accordion-content">
              <p>59FIFTY fitted architecture. Structured crown with a flat visor that can curve. Premium wool/poly blend fabric engineered for collectors.</p>
            </div>
          </div>

          <div class="accordion-item">
            <button type="button" class="accordion-toggle" onclick="toggleAccordion(this)">
              <span>SHIPPING & VAULT DISPATCH</span>
              <span class="acc-icon">[ + ]</span>
            </button>
            <div class="accordion-content">
              <p>Dispatched in custom crush-proof vault boxes within 24 hours. Global express shipping available.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Crown Matrix Terminal Modal Overlay -->
<div id="CrownMatrixModal" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(14, 14, 14, 0.94); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); z-index: 10005; display: none; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.25s ease;">
  <div style="width: 100%; max-width: 650px; margin: 20px; background: #0E0E0E; border: 1px solid {{ section.settings.grid_border }}; box-sizing: border-box; display: flex; flex-direction: column;">
    
    <!-- Modal Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; padding: 20px 24px; border-bottom: 1px solid {{ section.settings.grid_border }}; background: #121212;">
      <span style="font-family: monospace; font-size: 11px; color: {{ section.settings.accent_color }}; letter-spacing: 0.15em;">[ DIAGNOSTIC TOOL // CROWN MATRIX FITTED SIZING ]</span>
      <button type="button" onclick="closeCrownMatrixModal()" style="background: none; border: none; color: #888; font-family: monospace; font-size: 12px; cursor: pointer; letter-spacing: 0.1em;" onmouseover="this.style.color='#F5F5F5'" onmouseout="this.style.color='#888'">[ CLOSE X ]</button>
    </div>

    <!-- Modal Body Content -->
    <div style="padding: 24px; display: flex; flex-direction: column; gap: 20px; max-height: 80vh; overflow-y: auto;">
      
      <!-- Input Group -->
      <div style="display: flex; flex-direction: column; gap: 10px;">
        <label style="font-family: monospace; font-size: 11px; color: #888; letter-spacing: 0.1em;">HEAD CIRCUMFERENCE:</label>
        <div style="display: flex; gap: 10px;">
          <input type="number" id="ModalCmInput" placeholder="e.g. 58.7" min="50" max="66" step="0.1" style="flex: 1; background: #141414; border: 1px solid {{ section.settings.grid_border }}; color: {{ section.settings.text_color }}; padding: 14px 16px; font-family: monospace; font-size: 16px; outline: none;">
          <select id="ModalCmUnit" style="background: #141414; border: 1px solid {{ section.settings.grid_border }}; color: {{ section.settings.text_color }}; padding: 14px 16px; font-family: monospace; font-size: 14px; outline: none; cursor: pointer;">
            <option value="cm">CM</option>
            <option value="in">INCHES</option>
          </select>
        </div>
      </div>

      <!-- Fit Preference -->
      <div style="display: flex; flex-direction: column; gap: 10px;">
        <label style="font-family: monospace; font-size: 11px; color: #888; letter-spacing: 0.1em;">FIT PREFERENCE:</label>
        <div style="display: flex; gap: 10px;">
          <label style="flex: 1; font-family: monospace; font-size: 11px; padding: 10px; border: 1px solid {{ section.settings.grid_border }}; background: #141414; cursor: pointer; text-align: center; color: #aaa;">
            <input type="radio" name="ModalCmFit" value="snug"> SNUG [-0.4cm]
          </label>
          <label style="flex: 1; font-family: monospace; font-size: 11px; padding: 10px; border: 1px solid {{ section.settings.grid_border }}; background: #141414; cursor: pointer; text-align: center; color: #aaa;">
            <input type="radio" name="ModalCmFit" value="standard" checked> STANDARD [BALANCED]
          </label>
          <label style="flex: 1; font-family: monospace; font-size: 11px; padding: 10px; border: 1px solid {{ section.settings.grid_border }}; background: #141414; cursor: pointer; text-align: center; color: #aaa;">
            <input type="radio" name="ModalCmFit" value="relaxed"> RELAXED [+0.4cm]
          </label>
        </div>
      </div>

      <button type="button" id="ModalCmCalculateBtn" style="background: {{ section.settings.accent_color }}; color: #0E0E0E; border: none; font-family: 'Oswald', sans-serif; font-size: 14px; font-weight: 700; letter-spacing: 0.1em; padding: 16px; cursor: pointer;">
        [ RUN FITTED CROWN DIAGNOSTIC ]
      </button>

      <!-- Terminal Output Screen -->
      <div id="ModalCmTerminalScreen" style="background: #0A0A0A; border: 1px solid {{ section.settings.grid_border }}; padding: 16px; font-family: monospace; font-size: 12px; min-height: 100px; display: flex; flex-direction: column; gap: 6px;">
        <p style="margin: 0; color: #666;">[SYSTEM READY. AWAITING CRANIAL PARAMETERS...]</p>
      </div>

      <!-- Results Box -->
      <div id="ModalCmResultBox" style="display: none; flex-direction: column; gap: 14px; background: #121212; border: 1px solid {{ section.settings.grid_border }}; padding: 20px;">
        <div style="display: flex; justify-content: space-between; font-family: monospace; font-size: 13px;">
          <span style="color: #888;">OPTIMAL FITTED SIZE:</span>
          <span id="ModalCmResultSize" style="color: {{ section.settings.accent_color }}; font-weight: 700;">--</span>
        </div>
        <button type="button" onclick="applyCalculatedSize(document.getElementById('ModalCmResultSize').textContent)" style="background: transparent; border: 1px solid {{ section.settings.accent_color }}; color: {{ section.settings.accent_color }}; font-family: monospace; font-size: 12px; font-weight: 700; padding: 12px; cursor: pointer; letter-spacing: 0.1em;" onmouseover="this.style.background='rgba(212,175,55,0.1)'" onmouseout="this.style.background='transparent'">
          [ SELECT THIS FITTED SIZE & APPLY TO PDP &rarr; ]
        </button>
      </div>

    </div>
  </div>
</div>

<style>
  .pdp-architecture {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    max-width: 100vw;
    box-sizing: border-box;
    padding: 60px 60px 60px 40px;
  }
  .pdp-container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 60px;
    align-items: start;
  }

  /* Left Column: Viewport-Fitted Sticky Gallery */
  .pdp-gallery-column {
    position: relative;
  }
  .sticky-gallery-wrapper {
    position: sticky;
    top: 40px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-height: calc(100vh - 80px);
  }

  /* Back Icon Button Top-Left */
  .gallery-top-bar {
    display: flex;
    justify-content: flex-start;
  }
  .back-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: #141414;
    border: 1px solid {{ section.settings.grid_border }};
    color: {{ section.settings.text_color }};
    text-decoration: none;
    transition: all 0.2s;
  }
  .back-icon-btn:hover {
    border-color: {{ section.settings.accent_color }};
    color: {{ section.settings.accent_color }};
  }

  .main-image-viewport {
    flex: 1;
    min-height: 0;
    aspect-ratio: 1 / 1;
    background: #141414;
    border: 1px solid {{ section.settings.grid_border }};
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .main-viewport-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  
  /* Compact Horizontal Thumbnail Track */
  .thumbnail-track {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    flex-shrink: 0;
    padding-bottom: 4px;
  }
  .thumbnail-track::-webkit-scrollbar {
    height: 4px;
  }
  .thumbnail-track::-webkit-scrollbar-thumb {
    background: {{ section.settings.grid_border }};
  }
  .thumb-btn {
    background: #141414;
    border: 1px solid {{ section.settings.grid_border }};
    padding: 4px;
    width: 70px;
    height: 70px;
    cursor: pointer;
    transition: border-color 0.2s;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .thumb-btn.active, .thumb-btn:hover {
    border-color: {{ section.settings.accent_color }};
  }

  /* Right Column: Balanced Sticky Info */
  .pdp-info-column {
    position: relative;
  }
  .sticky-info-wrapper {
    position: sticky;
    top: 40px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: 52px;
  }
  .product-header-meta {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-bottom: 1px solid {{ section.settings.grid_border }};
    padding-bottom: 18px;
  }
  .blueprint-tag {
    font-family: monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
  }
  .pdp-title {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(1.8rem, 2.5vw, 2.6rem);
    font-weight: 700;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.1;
  }
  .pdp-price {
    font-family: monospace;
    font-size: 18px;
    font-weight: 700;
  }
  .pdp-description {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    line-height: 1.5;
    color: #cccccc;
  }

  /* Technical Size Matrix */
  .variant-picker-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .picker-header {
    display: flex;
    justify-content: space-between;
    font-family: monospace;
    font-size: 12px;
  }
  .picker-label {
    color: #888;
  }
  .selected-size-display {
    color: {{ section.settings.accent_color }};
    font-weight: 700;
  }
  .size-matrix-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }
  .size-matrix-btn {
    background: #141414;
    border: 1px solid {{ section.settings.grid_border }};
    color: {{ section.settings.text_color }};
    font-family: monospace;
    font-size: 12px;
    padding: 12px 0;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s;
  }
  .size-matrix-btn:hover:not(:disabled) {
    border-color: {{ section.settings.accent_color }};
  }
  .size-matrix-btn.active {
    border-color: {{ section.settings.accent_color }};
    background: #1e1e1e;
    color: {{ section.settings.accent_color }};
    font-weight: 700;
  }
  .size-matrix-btn.sold-out {
    background: #0a0a0a;
    color: #444;
    border-color: #1a1a1a;
    text-decoration: line-through;
    cursor: not-allowed;
  }

  /* Action Bar with Detached Top Margin & Cart UX */
  .pdp-action-bar {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 16px; 
  }
  .add-to-cart-btn {
    background: {{ section.settings.accent_color }};
    color: #0E0E0E;
    border: none;
    font-family: 'Oswald', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 16px;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .add-to-cart-btn:hover {
    opacity: 0.9;
  }
  .crown-matrix-trigger-btn {
    background: transparent;
    color: {{ section.settings.text_color }};
    border: 1px solid {{ section.settings.grid_border }};
    font-family: monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 16px;
    cursor: pointer;
    transition: border-color 0.2s;
  }
  .crown-matrix-trigger-btn:hover {
    border-color: {{ section.settings.accent_color }};
    color: {{ section.settings.accent_color }};
  }

  /* Brutalist Accordions */
  .pdp-accordions {
    display: flex;
    flex-direction: column;
    border-top: 1px solid {{ section.settings.grid_border }};
  }
  .accordion-item {
    border-bottom: 1px solid {{ section.settings.grid_border }};
  }
  .accordion-toggle {
    width: 100%;
    background: none;
    border: none;
    color: {{ section.settings.text_color }};
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 0;
    font-family: monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    cursor: pointer;
  }
  .accordion-toggle:hover {
    color: {{ section.settings.accent_color }};
  }
  .accordion-content {
    display: none;
    padding-bottom: 16px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    color: #aaa;
    line-height: 1.5;
  }
  .accordion-item.open .accordion-content {
    display: block;
  }

  /* Modal Open State */
  #CrownMatrixModal.open {
    opacity: 1 !important;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .pdp-container {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .sticky-gallery-wrapper, .sticky-info-wrapper {
      position: relative;
      top: 0;
      max-height: none;
      padding-top: 0;
    }
    .pdp-action-bar {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function switchProductImage(imgUrl, btn) {
    document.getElementById('MainProductImage').src = imgUrl;
    document.querySelectorAll('.thumb-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
  }

  function selectVariant(btn) {
    const variantId = btn.getAttribute('data-variant-id');
    const variantPrice = btn.getAttribute('data-variant-price');
    const isAvailable = btn.getAttribute('data-variant-available') === 'true';
    const sizeLabel = btn.getAttribute('data-size-label');

    document.getElementById('VariantIdInput').value = variantId;
    document.getElementById('ProductPrice').innerText = variantPrice;
    document.getElementById('SelectedSizeDisplay').innerText = sizeLabel;

    document.querySelectorAll('.size-matrix-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    const cartBtn = document.getElementById('AddToCartBtn');
    if (isAvailable) {
      cartBtn.removeAttribute('disabled');
      cartBtn.innerText = '[ ADD TO CART ]';
    } else {
      cartBtn.setAttribute('disabled', 'disabled');
      cartBtn.innerText = '[ SOLD OUT ]';
    }
  }

  function toggleAccordion(btn) {
    const item = btn.closest('.accordion-item');
    const icon = btn.querySelector('.acc-icon');
    
    item.classList.toggle('open');
    if (item.classList.contains('open')) {
      icon.innerText = '[ - ]';
    } else {
      icon.innerText = '[ + ]';
    }
  }

  /* Crown Matrix Modal Controllers */
  function openCrownMatrixModal() {
    const modal = document.getElementById('CrownMatrixModal');
    if (modal) {
      modal.style.display = 'flex';
      void modal.offsetWidth;
      modal.classList.add('open');
      const input = document.getElementById('ModalCmInput');
      if (input) input.focus();
    }
  }

  function closeCrownMatrixModal() {
    const modal = document.getElementById('CrownMatrixModal');
    if (modal) {
      modal.classList.remove('open');
      setTimeout(() => {
        modal.style.display = 'none';
      }, 250);
    }
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeCrownMatrixModal();
  });

  document.addEventListener('DOMContentLoaded', () => {
    const calcBtn = document.getElementById('ModalCmCalculateBtn');
    if (!calcBtn) return;

    calcBtn.addEventListener('click', () => {
      const inputVal = parseFloat(document.getElementById('ModalCmInput').value);
      const unit = document.getElementById('ModalCmUnit').value;
      const fitPref = document.querySelector('input[name="ModalCmFit"]:checked').value;
      const terminalScreen = document.getElementById('ModalCmTerminalScreen');
      const resultBox = document.getElementById('ModalCmResultBox');
      
      if (isNaN(inputVal) || inputVal <= 0) {
        alert('PLEASE ENTER A VALID CRANIUM MEASUREMENT.');
        return;
      }

      let cmVal = unit === 'in' ? inputVal * 2.54 : inputVal;

      // Adjust cm value based on fit preference
      if (fitPref === 'snug') cmVal -= 0.4;
      if (fitPref === 'relaxed') cmVal += 0.4;

      terminalScreen.innerHTML = '';
      resultBox.style.display = 'none';

      const logs = [
        `> INITIALIZING FITTED MATRIX PROTOCOL v3.0...`,
        `> PARSING: ${inputVal}${unit} [${fitPref.toUpperCase()} FIT ADJUSTMENT]`,
        `> CALCULATING 59FIFTY CRANIAL TOLERANCES...`,
        `> MATCHING VAULT FITTED SIZE INDEX...`
      ];

      let delay = 0;
      logs.forEach((log, index) => {
        setTimeout(() => {
          const p = document.createElement('p');
          p.className = 'cm-log-line';
          p.style.color = index === logs.length - 1 ? '{{ section.settings.accent_color }}' : '#aaa';
          p.textContent = log;
          terminalScreen.appendChild(p);
          terminalScreen.scrollTop = terminalScreen.scrollHeight;
        }, delay);
        delay += 300;
      });

      setTimeout(() => {
        // Fitted Hat Sizing Thresholds (cm to Hat Size)
        let matchedSize = '7 1/4';

        if (cmVal < 55.5) {
          matchedSize = '7';
        } else if (cmVal >= 55.5 && cmVal < 56.5) {
          matchedSize = '7 1/8';
        } else if (cmVal >= 56.5 && cmVal < 57.5) {
          matchedSize = '7 1/4';
        } else if (cmVal >= 57.5 && cmVal < 58.5) {
          matchedSize = '7 3/8';
        } else if (cmVal >= 58.5 && cmVal < 59.5) {
          matchedSize = '7 1/2';
        } else if (cmVal >= 59.5 && cmVal < 60.5) {
          matchedSize = '7 5/8';
        } else if (cmVal >= 60.5 && cmVal < 62.0) {
          matchedSize = '7 3/4';
        } else {
          matchedSize = '8';
        }

        document.getElementById('ModalCmResultSize').textContent = matchedSize;
        resultBox.style.display = 'flex';
      }, delay + 100);
    });
  });

  function applyCalculatedSize(sizeText) {
    const sizeButtons = document.querySelectorAll('.size-matrix-btn');
    let matched = false;
    
    sizeButtons.forEach(btn => {
      const btnLabel = btn.getAttribute('data-size-label').trim();
      if (btnLabel === sizeText && !btn.disabled) {
        selectVariant(btn);
        matched = true;
      }
    });

    if (matched) {
      closeCrownMatrixModal();
    } else {
      alert(`Calculated fitted size is ${sizeText}, but exact variant might be sold out or unavailable.`);
      closeCrownMatrixModal();
    }
  }
</script>

