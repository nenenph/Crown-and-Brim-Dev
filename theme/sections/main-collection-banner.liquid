<!-- sections/main-collection-banner.liquid -->
<div class="collection-banner-blueprint" style="background-color: {{ section.settings.bg_color }};">
  <div class="banner-inner">
    <span class="blueprint-tag" style="color: {{ section.settings.accent_color }};">
      [ {{ collection.products_count }} SILHOUETTES ARCHIVED ]
    </span>
    <h1 class="collection-title" style="color: {{ section.settings.text_color }};">
      {{ collection.title | escape }}
    </h1>
    {%- if collection.description != blank -%}
      <div class="collection-description" style="color: {{ section.settings.subtext_color }};">
        {{ collection.description }}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .collection-banner-blueprint {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    max-width: 100vw;
    box-sizing: border-box;
    border-bottom: 1px solid {{ section.settings.grid_border }};
    padding: 80px 40px 60px 40px;
    text-align: center;
  }
  .banner-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .blueprint-tag {
    font-family: monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
  }
  .collection-title {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 700;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.1;
    letter-spacing: 0.02em;
  }
  .collection-description {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    max-width: 600px;
    line-height: 1.6;
  }
</style>

{% schema %}
{
  "name": "Collection Banner",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0E0E0E"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext Color",
      "default": "#888888"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#D4AF37"
    },
    {
      "type": "color",
      "id": "grid_border",
      "label": "Border Color",
      "default": "#222222"
    }
  ]
}
{% endschema %}